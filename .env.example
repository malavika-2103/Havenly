# Copy this file to ".env" and fill in real values.
# .env is ignored by Git, so your secrets stay on your computer.

# Name of the running environment
APP_ENV=development

# PostgreSQL connection (used from Phase 2)
DATABASE_URL=postgresql://havenly:change_me@localhost:5432/havenly

# Token for protecting the MCP server (used later)
MCP_AUTH_TOKEN=change_me
