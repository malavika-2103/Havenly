# Copy to .env (npm run setup does this for you)
PORT=8787
# 127.0.0.1 = only this computer. Use 0.0.0.0 when deploying (and change ADMIN_TOKEN and TOKEN_SECRET).
HOST=127.0.0.1
ACTIVE_AREA=kakkanad
ADMIN_TOKEN=havenly-admin-demo
TOKEN_SECRET=change-me-to-a-long-random-string
DB_PATH=data/havenly.db
DEMO_MODE=true
BOOKING_EXPIRY_HOURS=72

# Live web results on the search page (https://tavily.com). Leave empty to turn the feature off.
TAVILY_API_KEY=
