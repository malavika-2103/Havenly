{
  "name": "havenly",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch --clear-screen=false server/src/index.ts",
    "start:server": "tsx server/src/index.ts",
    "seed": "tsx server/seed/seed.ts",
    "validate": "tsx server/seed/validate.ts",
    "purge:demo": "tsx server/seed/purge.ts",
    "test": "tsx --test server/test/*.test.ts",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p server",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "postinstall": "node -e \"require('fs').existsSync('.env')||require('fs').copyFileSync('.env.example','.env')\""
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
